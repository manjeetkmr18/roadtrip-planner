NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Browser key for the interactive map (Maps JavaScript API). Restrict it by HTTP referrer.
# Without it, the plan shows a simple route sketch instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud console (needed for advanced markers). DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
