# --- Core ---
PORT=4000
# Web app origins allowed by CORS, comma-separated (8081 = Expo web dev server). Phones don't need this.
WEB_ORIGIN=http://localhost:8081
DATABASE_URL=postgres://rtp:rtp@localhost:5432/roadtrip
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# true = run trip generation inside the API process (no Redis needed). On Vercel this is turned on automatically.
QUEUE_INLINE=false
# API docs at /api/docs, behind this username and password. Leave empty to turn the docs off.
DOCS_USERNAME=
DOCS_PASSWORD=
# auto = live APIs where a key is set, sample data otherwise. sample = always sample data (no API spend).
PROVIDER_MODE=auto
FREE_TRIPS_PER_MONTH=3
# Google Places searches per trip day. 1 = the traveller's interests take turns across days (cheapest).
PLACES_SEARCHES_PER_DAY=1
# USD fuel prices and fares are converted at the Bank of Canada's daily rate (fetched automatically, cached 6 h).
# This is only the fallback when that feed can't be reached.
USD_CAD_RATE=1.38

# --- Google Maps Platform (server key: Geocoding, Routes, Places API (New)) ---
# Restrict this key by API (Geocoding, Routes, Places New). Not by website: Google rejects referrer-restricted
# keys from servers. On Vercel there are no fixed IPs, so leave the application restriction at None.
GOOGLE_MAPS_API_KEY=

# --- Duffel flight search (fly + drive). Without it, flights are sample data. ---
# Searching is free; Duffel charges only for bookings, which Travlio doesn't make. https://duffel.com
DUFFEL_ACCESS_TOKEN=

# --- Amazon Bedrock (itinerary wording + stop choice) ---
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, a profile, or an IAM role).
AWS_REGION=us-east-1
# The model or inference-profile ID enabled in your Bedrock console, e.g. a Claude Sonnet model.
BEDROCK_MODEL_ID=
# Smaller, cheaper model used for choosing stops and writing day descriptions, e.g. a Claude Haiku model.
# Leave empty to use BEDROCK_MODEL_ID for everything.
BEDROCK_FAST_MODEL_ID=
# Token prices for cost tracking (USD per million tokens); set to your models' Bedrock prices.
LLM_INPUT_USD_PER_MTOK=2
LLM_OUTPUT_USD_PER_MTOK=10
LLM_FAST_INPUT_USD_PER_MTOK=0.1
LLM_FAST_OUTPUT_USD_PER_MTOK=0.5

# --- Free / open data (keys are free) ---
# Ontario 511 developer key: https://511on.ca/developers  (road closures on provincial highways)
ONTARIO_511_API_KEY=
# OilPriceAPI key (Canadian provincial gasoline averages): https://www.oilpriceapi.com
OILPRICEAPI_KEY=
# US EIA key (weekly US gasoline/diesel): https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# api.weather.gov asks for an identifying User-Agent with a contact address.
NWS_USER_AGENT=travlio (you@example.com)
